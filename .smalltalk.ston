SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'Nonogram',
      #directory : 'src',
      #load : [ 'default', 'App' ],
      #onConflict : #useLoaded,
      #onUpgrade : #useLoaded,
      #platforms : [ #pharo ]
    }
  ],
  #testing : {
    #packages : [ 'Nonogram-Tests', 'Nonogram-App-Tests' ],
    #coverage : {
      #packages : [ 'Nonogram', 'Nonogram-UI', 'Nonogram-App' ]
    }
  }
}
